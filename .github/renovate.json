{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "dependencyDashboard": true,
  "enabledManagers": ["dockerfile", "custom.regex"],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["(^|/)Dockerfile$"],
      "matchStrings": ["# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\nENV .*?_VERSION=(?<currentValue>.*)\\n"],
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "Disable major docker updates",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Pin docker image digests",
      "matchDatasources": ["docker"],
      "pinDigests": true
    },
    {
      "description": "Group docker digest updates",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["digest"],
      "groupName": "docker-digests"
    }
  ]
}