{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "dependencyDashboard": true,
  "enabledManagers": ["dockerfile", "custom.regex"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": ["# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\nENV .*?_VERSION=(?<currentValue>.*)\\n"],
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "Disable major docker updates",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Pin docker image digests",
      "matchDatasources": ["docker"],
      "pinDigests": true
    },
    {
      "description": "Group docker digest updates",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["digest"],
      "groupName": "docker-digests"
    },
    {
      "description": "Bun tags its GitHub releases bun-vX.Y.Z, which the semver versioning cannot compare against BUN_VERSION, so no update was ever proposed. Strip the prefix. Scoped to bun because KIOTA_VERSION is already a bare vX.Y.Z tag and must not be rewritten.",
      "matchDatasources": ["github-releases"],
      "matchDepNames": ["oven-sh/bun"],
      "extractVersion": "^bun-v(?<version>.+)$"
    }
  ]
}
